---
import { getEntry, render } from "astro:content";
import ArticleImages from "../components/ArticleImages.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const page = await getEntry("pages", "about");
if (!page) {
  throw new Error("Missing About page content.");
}
const { Content } = await render(page);
---

<BaseLayout title={page.data.title ?? "About"}>
  <h1>{page.data.title ?? "About"}</h1>
  <div
    class:list={[
      "post-content",
      page.data.imageAlign === "left" && "images-left",
      page.data.imageAlign === "right" && "images-right",
    ]}
  >
    <Content />
  </div>
  <ArticleImages />

  <style>
    :global(.post-content img) {
      display: block;
      margin: 0 auto 14px;
      max-width: min(200px, 100%);
      height: auto;
    }

    :global(.post-content img.post-image-wide) {
      max-width: 100%;
      max-height: min(80vh, 900px);
    }

    :global(.post-content.images-left img) {
      margin-left: 0;
      margin-right: auto;
    }

    :global(.post-content.images-right img) {
      margin-left: auto;
      margin-right: 0;
    }

    :global(.post-figure) {
      display: table;
      margin: 0 auto 14px;
      text-align: center;
    }

    :global(.post-content.images-left .post-figure),
    :global(.post-figure.images-left) {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    :global(.post-content.images-right .post-figure),
    :global(.post-figure.images-right) {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    :global(.post-figure.images-left img) {
      margin-left: 0;
      margin-right: auto;
    }

    :global(.post-figure.images-right img) {
      margin-left: auto;
      margin-right: 0;
    }

    :global(.post-figcaption) {
      margin-top: 6px;
      font-size: 0.95em;
      opacity: 0.85;
    }
  </style>


</BaseLayout>
