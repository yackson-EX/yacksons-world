---
import { getCollection, getEntry, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatFullDate } from "../../lib/dates";

const giscusTheme = import.meta.env.DEV
  ? "http://localhost:4321/giscus-theme.css?v=1"
  : new URL("/giscus-theme.css?v=1", Astro.site ?? "https://yacksons.world").toString();

const slugParam = Array.isArray(Astro.params.slug)
  ? Astro.params.slug.join("/")
  : Astro.params.slug ?? "";
const post = await getEntry("blog", slugParam);
if (!post) {
  throw new Response("Not found", { status: 404 });
}

const now = new Date();
const showFuturePosts =
  import.meta.env.DEV || import.meta.env.SHOW_FUTURE_POSTS === "true";
if (!showFuturePosts && post.data.pubDate.valueOf() > now.valueOf()) {
  throw new Response("Not found", { status: 404 });
}
const { Content } = await render(post);
---

<BaseLayout title={post.data.title}>
  <a href="/blog/">Back</a>
  <h1>{post.data.title}</h1>
  <p class="post-date">
    {formatFullDate(post.data.pubDate)}
    {showFuturePosts && post.data.pubDate.valueOf() > now.valueOf() && (
      <span class="scheduled-badge">Scheduled</span>
    )}
  </p>
  <div
    class:list={[
      "post-content",
      post.data.imageAlign === "left" && "images-left",
      post.data.imageAlign === "right" && "images-right",
    ]}
  >
    <Content />
  </div>
  <div class="post-lightbox" id="post-lightbox" aria-hidden="true">
    <div class="post-lightbox-frame" role="dialog" aria-modal="true" aria-label="Blog photo viewer">
      <button class="post-lightbox-close" type="button" aria-label="Close photo">✕</button>
      <button class="post-lightbox-prev" type="button" aria-label="Previous photo">‹</button>
      <button class="post-lightbox-next" type="button" aria-label="Next photo">›</button>
      <img class="post-lightbox-image" alt="" />
      <div class="post-lightbox-caption"></div>
    </div>
  </div>
  <section class="comments" aria-label="Comments">
    <script
      src="https://giscus.app/client.js"
      data-repo="yackson-EX/yacksons-world"
      data-repo-id="R_kgDORAkMlg"
      data-category="Comments"
      data-category-id="DIC_kwDORAkMls4C1hiM"
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="0"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme={giscusTheme}
      data-lang="en"
      crossorigin="anonymous"
      async
    ></script>
  </section>

  <style>
    .post-content :global(img) {
      display: block;
      margin: 0 auto;
      max-width: 100%;
      width: auto;
      height: auto;
    }

    .post-content.images-left :global(img) {
      margin-left: 0;
      margin-right: auto;
    }

    .post-content.images-right :global(img) {
      margin-left: auto;
      margin-right: 0;
    }

    :global(.post-figure) {
      display: table;
      max-width: 100%;
      margin: 0 auto 14px;
      text-align: center;
    }

    :global(.post-image-trigger) {
      display: block;
      max-width: 100%;
      margin: 0 auto;
      padding: 0;
      border: 0;
      background: transparent;
      cursor: pointer;
    }

    :global(.post-image-trigger:focus-visible) {
      outline: 2px solid #fff;
      outline-offset: 3px;
    }

    .post-content.images-left :global(.post-image-trigger) {
      margin-left: 0;
      margin-right: auto;
    }

    .post-content.images-right :global(.post-image-trigger) {
      margin-left: auto;
      margin-right: 0;
    }

    :global(.post-content.images-left .post-figure) {
      margin-left: 0;
      margin-right: auto;
      text-align: left;
    }

    :global(.post-content.images-right .post-figure) {
      margin-left: auto;
      margin-right: 0;
      text-align: right;
    }

    :global(.post-content.images-left .post-figure img) {
      margin-left: 0;
      margin-right: auto;
    }

    :global(.post-content.images-right .post-figure img) {
      margin-left: auto;
      margin-right: 0;
    }

    :global(.post-figcaption) {
      margin-top: 6px;
      font-size: 0.95em;
      opacity: 0.85;
    }

    /* Match the existing Photography page's viewer, scoped only to blog posts. */
    .post-lightbox {
      position: fixed;
      inset: 0;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 24px;
      background: rgba(0, 0, 0, 0.85);
      z-index: 999;
      overscroll-behavior: contain;
      touch-action: none;
    }

    .post-lightbox.is-open {
      display: flex;
    }

    .post-lightbox-frame {
      position: relative;
      width: 100%;
      max-width: min(1200px, 95vw);
      max-height: 90vh;
      padding: 23px 59px 19px;
      background: #000;
      border-top: 3px solid rgba(255, 255, 255, 0.35);
      border-left: 3px solid rgba(255, 255, 255, 0.35);
      border-right: 3px solid rgba(255, 255, 255, 0.12);
      border-bottom: 3px solid rgba(255, 255, 255, 0.12);
      box-shadow:
        inset 2px 2px 0 rgba(255, 255, 255, 0.08),
        inset -2px -2px 0 rgba(0, 0, 0, 0.6),
        0 0 0 2px rgba(255, 255, 255, 0.08);
    }

    .post-lightbox-image {
      display: block;
      max-width: 100%;
      max-height: 70vh;
      margin: 0 auto;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .post-lightbox-caption {
      margin-top: 10px;
      text-align: center;
      font-size: 0.95em;
      opacity: 0.85;
    }

    .post-lightbox-close {
      position: absolute;
      top: 10px;
      right: 10px;
      width: 32px;
      height: 32px;
      padding: 0;
      border: 0;
      background: transparent url("/x-button.png") no-repeat center / contain;
      color: transparent;
      font-size: 0;
    }

    .post-lightbox-prev,
    .post-lightbox-next {
      position: absolute;
      top: 50%;
      width: 36px;
      height: 36px;
      padding: 0;
      border: 0;
      background: transparent url("/arrow.png") no-repeat center / contain;
      color: transparent;
      font-size: 0;
      transform: translateY(-50%);
    }

    .post-lightbox-prev { left: 6px; }
    .post-lightbox-next { right: 6px; transform: translateY(-50%) scaleX(-1); }

    :global(.post-lightbox button[hidden]) { display: none; }

    :global(html.lightbox-open),
    :global(body.lightbox-open) {
      overflow: hidden;
      height: 100%;
      touch-action: none;
    }

    @media (max-width: 600px) {
      .post-lightbox { padding: 10px; }
      .post-lightbox-frame { padding: 24px 43px 16px; }
    }

    /* Reserve space for Giscus to reduce layout shift */
    .comments {
      min-height: 320px;
    }

  </style>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const figuresFromImages = (root) => {
        const imgs = Array.from(root.querySelectorAll("img"));
        imgs.forEach((img) => {
          if (img.dataset.captionized) return;
          const caption = img.getAttribute("alt");
          const width = Number(img.getAttribute("width"));
          const height = Number(img.getAttribute("height"));
          if (width > 0 && height > 0) {
            img.style.aspectRatio = `${width} / ${height}`;
          }
          if (!caption) return;

          const figure = document.createElement("figure");
          figure.className = "post-figure";
          const figcaption = document.createElement("figcaption");
          figcaption.className = "post-figcaption";
          figcaption.textContent = caption;

          const parent = img.parentNode;
          if (!parent) return;

          // If the image sits inside a paragraph, place the figure after the paragraph
          // to avoid invalid nesting and weird alignment.
          if (parent.tagName === "P") {
            parent.insertAdjacentElement("afterend", figure);
            figure.appendChild(img);
            figure.appendChild(figcaption);
            if (!parent.textContent.trim()) {
              parent.remove();
            }
          } else {
            parent.insertBefore(figure, img);
            figure.appendChild(img);
            figure.appendChild(figcaption);
          }

          img.dataset.captionized = "true";
        });
      };

      const container = document.querySelector(".post-content");
      if (container) {
        figuresFromImages(container);

        const lightbox = document.getElementById("post-lightbox");
        const lightboxImage = lightbox?.querySelector(".post-lightbox-image");
        const lightboxCaption = lightbox?.querySelector(".post-lightbox-caption");
        const closeButton = lightbox?.querySelector(".post-lightbox-close");
        const prevButton = lightbox?.querySelector(".post-lightbox-prev");
        const nextButton = lightbox?.querySelector(".post-lightbox-next");
        const triggers = [];
        let currentIndex = -1;
        let previousFocus = null;

        // Keep linked images acting as links; turn other post images into accessible buttons.
        for (const img of container.querySelectorAll("img")) {
          if (img.closest("a, button, picture, [data-no-lightbox]")) continue;
          const button = document.createElement("button");
          button.type = "button";
          button.className = "post-image-trigger";
          button.setAttribute("aria-label", "Enlarge image: " + (img.alt || "photo"));
          img.parentNode.insertBefore(button, img);
          button.appendChild(img);
          triggers.push(button);
        }

        const closeLightbox = () => {
          if (!lightbox?.classList.contains("is-open")) return;
          lightbox.classList.remove("is-open");
          lightbox.setAttribute("aria-hidden", "true");
          document.documentElement.classList.remove("lightbox-open");
          document.body.classList.remove("lightbox-open");
          if (lightboxImage) {
            lightboxImage.removeAttribute("src");
            lightboxImage.alt = "";
          }
          if (lightboxCaption) lightboxCaption.textContent = "";
          currentIndex = -1;
          if (previousFocus instanceof HTMLElement) previousFocus.focus();
          previousFocus = null;
        };

        const openAtIndex = (index) => {
          if (index < 0 || index >= triggers.length || !lightbox || !lightboxImage) return;
          const img = triggers[index].querySelector("img");
          if (!img) return;
          const source = img.currentSrc || img.src;
          if (!source) return;
          lightboxImage.src = source;
          lightboxImage.alt = img.alt;
          if (lightboxCaption) lightboxCaption.textContent = img.alt || "";
          currentIndex = index;
          if (!lightbox.classList.contains("is-open")) {
            previousFocus = document.activeElement;
            lightbox.classList.add("is-open");
            lightbox.setAttribute("aria-hidden", "false");
            document.documentElement.classList.add("lightbox-open");
            document.body.classList.add("lightbox-open");
            closeButton?.focus();
          }
        };

        const step = (delta) => {
          if (currentIndex === -1) return;
          openAtIndex((currentIndex + delta + triggers.length) % triggers.length);
        };

        triggers.forEach((button, index) => {
          button.addEventListener("click", () => openAtIndex(index));
        });
        if (prevButton) prevButton.hidden = triggers.length < 2;
        if (nextButton) nextButton.hidden = triggers.length < 2;
        closeButton?.addEventListener("click", closeLightbox);
        prevButton?.addEventListener("click", () => step(-1));
        nextButton?.addEventListener("click", () => step(1));
        lightbox?.addEventListener("click", (event) => {
          if (event.target === lightbox) closeLightbox();
        });

        let touchStartX = 0;
        lightbox?.addEventListener("touchstart", (event) => {
          touchStartX = event.changedTouches[0]?.clientX ?? 0;
        }, { passive: true });
        lightbox?.addEventListener("touchend", (event) => {
          const delta = (event.changedTouches[0]?.clientX ?? 0) - touchStartX;
          if (Math.abs(delta) > 40) step(delta > 0 ? -1 : 1);
        }, { passive: true });

        window.addEventListener("keydown", (event) => {
          if (!lightbox?.classList.contains("is-open")) return;
          if (event.key === "Escape") {
            closeLightbox();
          } else if (event.key === "ArrowLeft") {
            step(-1);
          } else if (event.key === "ArrowRight") {
            step(1);
          } else if (event.key === "Tab") {
            // Keep keyboard focus inside the modal until it closes.
            const buttons = [closeButton, prevButton, nextButton]
              .filter((button) => button instanceof HTMLButtonElement && !button.hidden);
            const first = buttons[0];
            const last = buttons[buttons.length - 1];
            if (event.shiftKey && document.activeElement === first) {
              event.preventDefault();
              last?.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
              event.preventDefault();
              first?.focus();
            }
          }
        });
      }
    });
  </script>
</BaseLayout>
